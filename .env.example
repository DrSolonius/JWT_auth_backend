# Copia este archivo como .env y completa los datos de tu PostgreSQL local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clase
DB_USER=alumno
DB_PASSWORD=mi_clave_segura

# Autenticación (JWT).
# Genera un secreto propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
# false solo en desarrollo (http). En producción, con HTTPS, debe ser true.
COOKIE_SECURE=false

# Administrador que aprueba las cuentas nuevas. La contraseña real va solo en tu .env.
# Al arrancar, la API deja a este usuario con exactamente estos datos.
ADMIN_EMAIL=admin@academico.test
ADMIN_PASSWORD=

# pgAdmin (http://localhost:5050). Estos valores solo se usan la primera vez que arranca.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
