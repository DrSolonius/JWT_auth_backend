# Copia este archivo como .env y completa los datos de tu PostgreSQL local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clase
DB_USER=alumno
DB_PASSWORD=mi_clave_segura

# Autenticación (JWT).
# Genera un secreto propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
# false solo en desarrollo (http). En producción, con HTTPS, debe ser true.
COOKIE_SECURE=false

# Base de pruebas (la usa pytest; la crea db-init con docker compose up -d db).
# Es otra base: los tests la vacían después de cada test.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=clase_test
TEST_DB_USER=alumno
TEST_DB_PASSWORD=
